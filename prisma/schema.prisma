generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  admin
  support_agent
  viewer
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  refreshTokenHash String?

  memberships      Membership[]

  aiQuestions AiQuestion[] @relation("AiQuestions")
  
  uploadedDocuments Document[] @relation("DocumentUploader")

  supportDrafts SupportDraft[] @relation("SupportDrafts")

  usageEvents UsageEvent[] @relation("UsageEvents")

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("users")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?

  memberships Membership[]

  documents Document[]

  aiQuestions AiQuestion[]

  supportDrafts SupportDraft[]

  usageEvents UsageEvent[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())

  userId         String
  organizationId String
  role           MembershipRole @default(viewer)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

enum DocumentStatus {
  uploaded
  processing
  indexed
  failed
  deleted
}

model Document {
  id             String         @id @default(cuid())

  organizationId String
  uploadedById   String

  title          String
  originalName   String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  status         DocumentStatus @default(uploaded)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  chunks         DocumentChunk[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([uploadedById])
  @@index([status])
  @@map("documents")
}

model DocumentChunk {
  id             String   @id @default(cuid())

  organizationId String
  documentId     String

  content        String
  chunkIndex     Int
  tokenCount     Int?
  embedding      Unsupported("vector(1536)")?

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([organizationId])
  @@index([documentId])
  @@map("document_chunks")
}

enum AiQuestionStatus {
  answered
  needs_review
  failed
}

model AiQuestion {
  id             String           @id @default(cuid())

  organizationId String
  askedById      String

  question       String
  answer         String?
  status         AiQuestionStatus @default(answered)
  needsReview    Boolean          @default(false)

  sources        Json?

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  askedBy        User             @relation("AiQuestions", fields: [askedById], references: [id], onDelete: Restrict)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([askedById])
  @@index([status])
  @@map("ai_questions")
}

enum SupportTone {
  neutral
  friendly
  professional
  concise
}

model SupportDraft {
  id              String      @id @default(cuid())

  organizationId  String
  createdById     String

  customerMessage String
  reply           String
  tone            SupportTone @default(neutral)

  sources         Json?
  riskFlags       String[]
  needsReview     Boolean     @default(false)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("SupportDrafts", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([createdById])
  @@index([needsReview])
  @@map("support_drafts")
}

enum UsageEventType {
  document_uploaded
  document_indexed
  embedding_generated
  ai_question_asked
  support_reply_generated
}

model UsageEvent {
  id             String         @id @default(cuid())

  organizationId String
  userId         String?

  type           UsageEventType

  quantity       Int            @default(1)
  metadata       Json?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?          @relation("UsageEvents", fields: [userId], references: [id], onDelete: SetNull)

  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("usage_events")
}