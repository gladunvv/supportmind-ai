generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  refreshTokenHash String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}