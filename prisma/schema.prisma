generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  admin
  support_agent
  viewer
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  refreshTokenHash String?

  memberships      Membership[]

  aiQuestions AiQuestion[] @relation("AiQuestions")
  
  uploadedDocuments Document[] @relation("DocumentUploader")

  supportDrafts SupportDraft[] @relation("SupportDrafts")

  usageEvents UsageEvent[] @relation("UsageEvents")

  auditLogs AuditLog[] @relation("AuditLogs")

  createdApiKeys ApiKey[] @relation("CreatedApiKeys")

  createdWebhookEndpoints WebhookEndpoint[] @relation("CreatedWebhookEndpoints")

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("users")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?

  memberships Membership[]

  documents Document[]

  aiQuestions AiQuestion[]

  supportDrafts SupportDraft[]

  usageEvents UsageEvent[]

  auditLogs AuditLog[]

  apiKeys ApiKey[]

  knowledgeGaps KnowledgeGap[]

  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())

  userId         String
  organizationId String
  role           MembershipRole @default(viewer)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

enum DocumentStatus {
  uploaded
  processing
  indexed
  failed
  deleted
}

model Document {
  id             String         @id @default(cuid())

  organizationId String
  uploadedById   String

  title          String
  originalName   String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  status         DocumentStatus @default(uploaded)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  chunks         DocumentChunk[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([uploadedById])
  @@index([status])
  @@map("documents")
}

model DocumentChunk {
  id             String   @id @default(cuid())

  organizationId String
  documentId     String

  content        String
  chunkIndex     Int
  tokenCount     Int?
  embedding      Unsupported("vector(1536)")?

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([organizationId])
  @@index([documentId])
  @@map("document_chunks")
}

enum AiQuestionStatus {
  answered
  needs_review
  failed
}

model AiQuestion {
  id             String           @id @default(cuid())

  organizationId String
  askedById      String

  question       String
  answer         String?
  status         AiQuestionStatus @default(answered)
  needsReview    Boolean          @default(false)

  sources        Json?

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  askedBy        User             @relation("AiQuestions", fields: [askedById], references: [id], onDelete: Restrict)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([askedById])
  @@index([status])
  @@map("ai_questions")
}

enum SupportTone {
  neutral
  friendly
  professional
  concise
}

model SupportDraft {
  id              String      @id @default(cuid())

  organizationId  String
  createdById     String

  customerMessage String
  reply           String
  tone            SupportTone @default(neutral)

  sources         Json?
  riskFlags       String[]
  needsReview     Boolean     @default(false)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("SupportDrafts", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([createdById])
  @@index([needsReview])
  @@map("support_drafts")
}

enum UsageEventType {
  document_uploaded
  document_indexed
  embedding_generated
  ai_question_asked
  support_reply_generated
  api_key_request
  knowledge_gap_detected
}

model UsageEvent {
  id             String         @id @default(cuid())

  organizationId String
  userId         String?

  type           UsageEventType

  quantity       Int            @default(1)
  metadata       Json?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?          @relation("UsageEvents", fields: [userId], references: [id], onDelete: SetNull)

  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("usage_events")
}

enum AuditLogAction {
  organization_created
  organization_updated
  organization_archived

  member_added
  member_role_updated
  member_removed

  document_uploaded
  document_deleted
  document_indexed
  document_failed

  ai_question_asked
  support_draft_generated

  api_key_created
  api_key_revoked
  api_key_used

  knowledge_gap_created
  knowledge_gap_resolved
  knowledge_gap_ignored

  webhook_endpoint_created
  webhook_endpoint_disabled
  webhook_delivery_succeeded
  webhook_delivery_failed
}

model AuditLog {
  id             String         @id @default(cuid())

  organizationId String
  actorUserId    String?

  action         AuditLogAction
  entityType     String
  entityId       String?

  metadata       Json?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?          @relation("AuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ApiKeyStatus {
  active
  revoked
}

model ApiKey {
  id             String       @id @default(cuid())

  organizationId String
  createdById    String?

  name           String
  keyHash        String       @unique
  keyPrefix      String
  status         ApiKeyStatus @default(active)

  lastUsedAt     DateTime?
  revokedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("CreatedApiKeys", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@index([keyPrefix])
  @@map("api_keys")
}

enum KnowledgeGapStatus {
  open
  ignored
  resolved
}


model KnowledgeGap {
  id             String             @id @default(cuid())

  organizationId String

  question       String
  normalizedText String
  status         KnowledgeGapStatus @default(open)

  frequency      Int                @default(1)
  lastAskedAt    DateTime           @default(now())

  exampleSources Json?
  metadata       Json?

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, normalizedText])
  @@index([organizationId])
  @@index([status])
  @@index([lastAskedAt])
  @@map("knowledge_gaps")
}

enum WebhookEventType {
  document_indexed
  document_failed
  ai_question_needs_review
  support_draft_needs_review
  knowledge_gap_created
}

enum WebhookEndpointStatus {
  active
  disabled
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed
}

model WebhookEndpoint {
  id             String                @id @default(cuid())

  organizationId String
  createdById    String?

  name           String
  url            String
  secret         String
  status         WebhookEndpointStatus @default(active)

  events         WebhookEventType[]

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("CreatedWebhookEndpoints", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries     WebhookDelivery[]

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  disabledAt     DateTime?

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String                @id @default(cuid())

  organizationId    String
  webhookEndpointId String

  eventType         WebhookEventType
  status            WebhookDeliveryStatus @default(pending)

  payload           Json
  responseStatus    Int?
  responseBody      String?
  errorMessage      String?

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEndpoint   WebhookEndpoint       @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())
  deliveredAt       DateTime?

  @@index([organizationId])
  @@index([webhookEndpointId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_deliveries")
}